# Copy this file to .env and fill in the values. Never commit .env to GitHub.
SECRET_KEY=change-this-to-a-long-random-string
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Email alerts to guardians (optional). Gmail: use an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Country code used when a contact's number has 10 digits (India = 91)
DEFAULT_COUNTRY_CODE=91

# Set to 1 when deployed on HTTPS (Render)
COOKIE_SECURE=0
# DATABASE_PATH=/var/data/safeher.db
